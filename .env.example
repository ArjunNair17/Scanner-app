# Copy to `.env` for local Expo. Never commit real keys.

# Cloudflare Worker origin (no trailing slash), e.g. https://protein-scanner.<account>.workers.dev
EXPO_PUBLIC_WORKER_URL=

# Set to 1 to skip the network and return a sample identified meal (Expo Go / offline).
EXPO_PUBLIC_SCAN_STUB=0

# RevenueCat iOS public SDK key. Leave as placeholder to use the purchases stub.
# The app never fakes a purchase. Without a real key + a dev client, StoreKit is disabled.
EXPO_PUBLIC_RC_IOS_KEY=placeholder
